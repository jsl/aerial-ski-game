# Delegated-agent raw output. The TASK prompts are committed (they are the
# reproducible input); the model's raw responses and stderr are not.
.delegate/out/

# Node — dev tooling only; the shipped game has no dependencies (ADR-0010)
node_modules/
package-lock.json

# Playwright artefacts
test-results/
playwright-report/
npm-debug.log*

# Editor / OS
.DS_Store
*.swp
*~

# Local scratch
*.bak

# Python bytecode from the Blender build scripts
__pycache__/
*.pyc

# Visual-inspection renders. Regenerated by tests/drive/look.spec.js and
# compare.spec.js on demand; they are output, not source, and they churn on
# every render tweak.
shots/

# Reference footage (author-supplied clips and extracted frames; not source)
reference/

# reference/ is local data; ignore the path itself (a tracked symlink once overwrote the directory on merge)
reference
